<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules); see backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="lumen_catalog_v1/assets/" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="lumen_catalog_v1/assets/" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
